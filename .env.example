DATABASE_URL=postgres://ooh_app:ooh_app_password@localhost:5432/ooh_market
TEST_DATABASE_URL=postgres://ooh_app:ooh_app_password@localhost:5432/ooh_market_test
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false
# Production RDS should use DATABASE_SSL=true and certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Store the AWS RDS CA bundle as Base64 in Secrets Manager when required.
DATABASE_SSL_CA_BASE64=
BOOTSTRAP_ADMIN_TOKEN=change-me-before-production
APP_ORIGIN=http://localhost:3000
PUBLIC_API_BASE64_MAX_BYTES=20971520
MEDIA_STORAGE_PROVIDER=local
MEDIA_BUCKET=
MEDIA_KEY_PREFIX=
AWS_REGION=ca-central-1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Additive roadmap features are opt-in. Payment collection must remain false
# until Phase 7 is explicitly authorized and its provider/audit gates pass.
FEATURE_CAMPAIGN_MODEL_V2=false
FEATURE_AGENCY_WORKSPACE=false
FEATURE_STATIC_FULFILLMENT=false
FEATURE_PAYMENTS=false

# Shared-token delivery ingestion is retired; use paired player credentials.
ENABLE_DEMO_DELIVERY_TICK=false

# P1 authenticated browser players. Off until explicitly enabled for a pilot.
FEATURE_PLAYER_CONTROL=false
PLAYER_POLL_MS=10000
PLAYER_HEARTBEAT_MS=30000
PLAYER_STALE_MS=90000

# Stop/revocation delay while disconnected; maximum 86400 for an explicit offline pilot.
PLAYER_OFFLINE_LEASE_SECONDS=86400

# P4 owner fleet policy, grouping, schedules, and scoped editor controls
FEATURE_FLEET_OPERATIONS=false
